# Conexao com o Postgres (Neon em producao, local em desenvolvimento)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/eletrohub
PGSSL=false

# Porta do servidor
PORT=4000

# Segredos para os tokens JWT (troque por strings aleatorias longas em producao)
JWT_CLIENT_SECRET=troque-este-segredo-cliente
JWT_ADMIN_SECRET=troque-este-segredo-admin

# Origem permitida para CORS (URL do frontend no Vercel)
FRONTEND_URL=http://localhost:5173

# IA - opcional. Sem a key, o endpoint de insights retorna um aviso
# informando que a integracao esta pronta mas sem credencial configurada.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# SMTP - opcional. Sem configuracao, o "envio de e-mail" do admin
# e apenas registrado no log do servidor (nao trava a funcionalidade).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EletroHub <no-reply@eletrohub.com>
